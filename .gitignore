.installed.cfg
*.egg

# Virtual environment
venv/
ENV/
env/
.venv/

# Jupyter Notebook
.ipynb_checkpoints

# Pytest cache
.cache

# MyPy
.mypy_cache/
.dmypy.json

# Data files
/data/

# Zip archives
*.zip

# macOS system files
.DS_Store
*.DS_Store
**/.DS_Store
